{
  "name": "u-vision-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:embed": "cross-env VITE_BASE=/u-vision/ vite build --outDir ../server/src/UVision.Hosting/wwwroot --emptyOutDir",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "@uplatform/brand": "^0.4.0",
    "barcode-detector": "^3.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
