# VLM provider 설정
VLM_PROVIDER=mock            # mock | openai-compatible | openai | google
VLM_MODEL=gpt-4o
VLM_API_KEY=

# openai-compatible(GPUStack · vLLM · Ollama 등 셀프호스트 서버)의 서버 주소(예: http://host:8080).
# 표준 경로 /v1 은 자동으로 붙는다(이미 적었으면 그대로). openai/google 은 비워둔다.
VLM_ENDPOINT=

# 전용 ML 분류기(신뢰성 플라이휠 ②~③ 2중체크) — VLM 과 직교한 교차검증 판정원.
# none(기본) = ML 없음(VLM 단독, ② 이전과 동일). mock = 키 없는 데모(불일치→검토 큐 구동).
# mloop = 학습 모델 serve(ML_ENDPOINT 필요 — 이미지를 파일 경로로 넘기므로 같은 호스트).
ML_PROVIDER=none             # none | mock | mloop
ML_ENDPOINT=                 # mloop serve base URL(예: http://host:5000) — mloop 전용
ML_MODEL=default             # mloop promote 모델 이름
ML_TOKEN=                    # mloop serve JWT Bearer(비면 헤더 미부착)
# 2중체크 검토 임계: VLM 또는 ML 신뢰도 < 값이면 requires_review. 0(기본)=불일치만 검토.
ML_REVIEW_CONFIDENCE_THRESHOLD=0

# 확정 사례 기억 단(system 1) — 사람이 확정한 라벨 이미지와 닮았는지로 답하거나 기권한다. 지금은 관찰 전용(판정 무변경,
# 결정 장부에만 남음). none(기본) = 단 없음. mock = 키 없는 데모(같은 바이트만 닮음). mloop = mloop serve 의 /embed
# (이미지 내용을 보내므로 같은 호스트일 필요 없음, MLoop 0.44.0+). 인코더는 MLoop 에 설치하고 그 id 를 적는다.
MEMORY_PROVIDER=none         # none | mock | mloop
MEMORY_ENDPOINT=             # mloop serve base URL — mloop 전용
MEMORY_ENCODER=              # mloop encoder list 의 id — mloop 전용
MEMORY_TOKEN=                # mloop serve JWT Bearer(비면 헤더 미부착)

# 업로드 제한 (DoS 방지)
MAX_UPLOAD_SIZE_MB=10
