<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UVision.Hosting\UVision.Hosting.csproj" />
    <!-- inject 가 실행 중인 엔진을 공개 클라이언트로 부른다(소비자와 같은 길). -->
    <ProjectReference Include="..\UVision.Client\UVision.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmark 가 .env 로딩에 직접 사용(Program.cs). Hosting 라이브러리는 DotNetEnv 미의존(소비자 오염 방지)이라 직접 선언. -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 표본 목록 등 순수 로직의 단위 테스트(테스트는 extern alias 로 참조 — 최상위 Program 이 Api 의 Program 과 겹치지 않게). -->
    <InternalsVisibleTo Include="UVision.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
