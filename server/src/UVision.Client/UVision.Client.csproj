<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>UVision.Client</PackageId>
    <Version>0.5.0</Version>
    <Description>Typed HTTP client for the U-Vision judgment engine, generated from its OpenAPI contract.</Description>
    <Authors>iyulab</Authors>
    <PackageProjectUrl>https://github.com/iyulab/U-Vision</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/U-Vision</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 클라이언트는 엔진과 프로세스 경계 건너편(부르는 앱 안)에 링크되므로 MIT — 엔진은 AGPL-3.0-or-later. 원문은 옆의 LICENSE. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- 생성 코드는 모든 멤버에 XML 문서를 달지 않는다. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UVision.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>

</Project>
