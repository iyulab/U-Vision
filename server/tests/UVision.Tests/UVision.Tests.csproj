<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 테스트는 Microsoft.Testing.Platform 위의 실행 파일이다(러너 선택은 server/global.json). -->
    <OutputType>Exe</OutputType>
    <!-- xunit.v3 분석기의 «테스트 취소 토큰을 넘겨라» 권고. 이 스위트는 중간 취소에 기대지 않고
         수백 호출처에 토큰만 기계적으로 끼우는 것은 소음이라 끈다. 취소에 반응해야 하는 테스트가 생기면 그 테스트에서 켠다. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UVision.Api\UVision.Api.csproj" />
    <ProjectReference Include="..\..\src\UVision.Hosting\UVision.Hosting.csproj" />
    <ProjectReference Include="..\..\src\UVision.Client\UVision.Client.csproj" />
    <!-- 측정 도구의 순수 로직(표본 목록 중복 · 누수 제거). 별칭 — Benchmark 의 최상위 Program 이 전역에 보이지 않게. -->
    <ProjectReference Include="..\..\src\UVision.Benchmark\UVision.Benchmark.csproj" Aliases="bench" />
  </ItemGroup>

</Project>