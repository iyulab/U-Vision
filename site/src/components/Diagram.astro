---
// Where U-Vision sits on site: what comes in, where it judges, what goes out. Solid lines work today; dashed lines
// are on the roadmap (the same rule as the dashed viewfinder brackets). Two drawings of the same thing: a wide one,
// and a tall one for narrow screens, where the wide one's text would shrink past reading.
import { COPY, type Locale } from '../copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = COPY[locale].integration.diagram;
---

<figure class="diagram">
  <svg class="wide" viewBox="0 0 960 370" role="img" aria-label={d.label}>
    <defs>
      <marker id="arrow-w" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="tip" />
      </marker>
    </defs>
    <g class="node"><rect x="10" y="70" width="230" height="70" rx="12" /><text x="125" y="111" text-anchor="middle">{d.tablet}</text></g>
    <g class="node planned"><rect x="10" y="250" width="230" height="70" rx="12" /><text x="125" y="291" text-anchor="middle">{d.camera}</text></g>
    <g class="engine">
      <rect x="340" y="130" width="250" height="140" rx="16" />
      <text x="465" y="192" text-anchor="middle" class="strong">{d.engine}</text>
      <text x="465" y="222" text-anchor="middle" class="sub">{d.engineSub}</text>
    </g>
    <g class="node"><rect x="355" y="10" width="220" height="56" rx="12" /><text x="465" y="44" text-anchor="middle">{d.model}</text></g>
    <g class="node"><rect x="750" y="160" width="200" height="80" rx="12" /><text x="850" y="206" text-anchor="middle">{d.mes}</text></g>
    <g class="link">
      <path d="M 240 105 C 295 105, 290 170, 337 170" marker-end="url(#arrow-w)" />
      <path d="M 465 68 L 465 127" marker-start="url(#arrow-w)" marker-end="url(#arrow-w)" />
      <path d="M 592 180 L 747 180" marker-end="url(#arrow-w)" />
    </g>
    <g class="link planned">
      <path d="M 240 285 C 295 285, 290 230, 337 230" marker-end="url(#arrow-w)" />
      <path d="M 592 220 L 747 220" marker-end="url(#arrow-w)" />
      <path d="M 850 243 C 850 340, 600 350, 520 273" marker-end="url(#arrow-w)" />
    </g>
    <g class="caption">
      <text x="670" y="168" text-anchor="middle">{d.webhook}</text>
      <text x="670" y="242" text-anchor="middle" class="planned-text">{d.protocols}</text>
      <text x="720" y="352" text-anchor="middle" class="planned-text">{d.orders}</text>
    </g>
  </svg>

  <svg class="tall" viewBox="0 0 420 640" role="img" aria-label={d.label}>
    <defs>
      <marker id="arrow-t" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="tip" />
      </marker>
    </defs>
    <g class="node"><rect x="6" y="6" width="198" height="64" rx="12" /><text x="105" y="44" text-anchor="middle">{d.tablet}</text></g>
    <g class="node planned"><rect x="216" y="6" width="198" height="64" rx="12" /><text x="315" y="44" text-anchor="middle">{d.camera}</text></g>
    <g class="engine">
      <rect x="40" y="150" width="340" height="110" rx="16" />
      <text x="210" y="198" text-anchor="middle" class="strong">{d.engine}</text>
      <text x="210" y="226" text-anchor="middle" class="sub">{d.engineSub}</text>
    </g>
    <g class="node"><rect x="120" y="330" width="180" height="56" rx="12" /><text x="210" y="364" text-anchor="middle">{d.model}</text></g>
    <g class="node"><rect x="40" y="540" width="340" height="72" rx="12" /><text x="210" y="582" text-anchor="middle">{d.mes}</text></g>
    <g class="link">
      <path d="M 105 72 L 105 147" marker-end="url(#arrow-t)" />
      <path d="M 210 262 L 210 327" marker-start="url(#arrow-t)" marker-end="url(#arrow-t)" />
      <path d="M 60 262 L 60 537" marker-end="url(#arrow-t)" />
    </g>
    <g class="link planned">
      <path d="M 315 72 L 315 147" marker-end="url(#arrow-t)" />
      <path d="M 92 262 L 92 537" marker-end="url(#arrow-t)" />
      <path d="M 360 537 L 360 263" marker-end="url(#arrow-t)" />
    </g>
    <g class="caption">
      <text x="104" y="430">{d.webhook}</text>
      <text x="104" y="452" class="planned-text">{d.protocols}</text>
      <text x="348" y="452" text-anchor="end" class="planned-text">{d.orders}</text>
    </g>
  </svg>
  <figcaption>{d.legend}</figcaption>
</figure>
